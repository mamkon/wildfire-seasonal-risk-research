// Reference: Display-only companion; precise numeric measure retained
// Model format: text
Monthly Record Share Label =
VAR P = [Monthly Record Share]
VAR Magnitude = ABS(P)
VAR SignText = IF(P < 0, "decrease ", "")
RETURN SWITCH(TRUE(),
    ISBLANK(P), "Not available",
    P = 0, "0%",
    P = 1, "100%",
    P = -1, "-100%",
    Magnitude < 0.01, SignText & "under 1%",
    Magnitude > 0.99 && Magnitude < 1, SignText & "over 99%",
    Magnitude > 1 && Magnitude < 1.01, SignText & "over 100%",
    FORMAT(P, "0%"))

// Reference: Display-only companion; precise numeric measure retained
// Model format: text
Mapped Top Five Cell Share Label =
VAR P = [Mapped Top Five Cell Share]
VAR Magnitude = ABS(P)
VAR SignText = IF(P < 0, "decrease ", "")
RETURN SWITCH(TRUE(),
    ISBLANK(P), "Not available",
    P = 0, "0%",
    P = 1, "100%",
    P = -1, "-100%",
    Magnitude < 0.01, SignText & "under 1%",
    Magnitude > 0.99 && Magnitude < 1, SignText & "over 99%",
    Magnitude > 1 && Magnitude < 1.01, SignText & "over 100%",
    FORMAT(P, "0%"))

// Reference: Executive answer card value, not a dynamic sentence
// Model format: text
Agency Concentration Range Label =
VAR LowLabel = [Agency Top 3 Minimum Label]
VAR HighLabel = [Agency Top 3 Maximum Label]
RETURN LowLabel & " to " & HighLabel

// Reference: vw_kpi_summary mean minus median
// Model format: #,0.00
Mean vs Median Gap Ha =
VAR Gap = [Mean Size Ha] - [Median Size Ha]
RETURN Gap

// Reference: Distinct reporting agencies with selected records in current context
// Model format: #,0
Scope Agency Count =
VAR Agencies = FILTER(VALUES(dim_agency[agency_key]), CALCULATE([Total Records]) > 0)
RETURN COUNTROWS(Agencies)

// Reference: Current dimension context and approved analysis scope
// Model format: text
Scope Subtitle =
VAR Years = FILTER(VALUES(dim_year[year_key]), dim_year[year_key] >= 2000 && dim_year[year_key] <= 2025)
VAR FirstYear = MINX(Years, dim_year[year_key])
VAR LastYear = MAXX(Years, dim_year[year_key])
VAR Agencies = [Scope Agency Count]
RETURN IF(ISBLANK(FirstYear), "No matching scope", "Fixed reporting-agency series | " & FORMAT(FirstYear,"0") & "–" & FORMAT(LastYear,"0") & " | " & FORMAT(Agencies,"0") & " reporting agencies | Counts: reported records; area: summed SIZE_HA in ha, not unique land.")

// Reference: NT-only period and definitions, not a headline
// Model format: text
NT Scope Subtitle =
VAR Years = FILTER(VALUES(dim_year[year_key]), dim_year[year_key] >= 2000 && dim_year[year_key] <= 2025)
VAR FirstYear = MINX(Years, dim_year[year_key])
VAR LastYear = MAXX(Years, dim_year[year_key])
RETURN IF(ISBLANK(FirstYear), "No matching scope", "Northwest Territories reporting agency | " & FORMAT(FirstYear,"0") & "–" & FORMAT(LastYear,"0") & " | 1 reporting agency | Record and reported-area shares include Unknown; FUL full, MOD modified, MON monitored.")

// Reference: load_batch.source_version
// Model format: text
Source Version =
VAR VersionText = SELECTEDVALUE(load_batch[source_version], "Multiple source versions")
RETURN "Source version: " & VersionText

